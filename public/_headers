# Cloudflare Pages headers — CLAUDE.md §8.
#
# CSP is intentionally tight: this is a static site with no inline handlers,
# no third-party scripts and no font CDN. Sentry is allowed for error
# reporting (§8) and OpenStreetMap tile hosts for the Leaflet map (§2).
# Nothing here permits an inline <script>, so a data-derived string can never
# execute even if escaping were somehow bypassed.

/*
  Content-Security-Policy: default-src 'self'; script-src 'self' https://*.sentry.io; style-src 'self'; img-src 'self' data: https://*.tile.openstreetmap.org https://*.basemaps.cartocdn.com; font-src 'self'; connect-src 'self' https://*.sentry.io; frame-ancestors 'none'; base-uri 'self'; form-action 'none'; object-src 'none'; upgrade-insecure-requests
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: geolocation=(self), camera=(), microphone=(), payment=(), usb=()
  Cross-Origin-Opener-Policy: same-origin

# Fingerprinted build assets are safe to cache forever.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Self-hosted fonts never change without a filename change.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
