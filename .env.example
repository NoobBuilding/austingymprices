# austingymprices.com — required environment variables
#
# This file documents WHICH variables exist. It contains placeholders only.
# Never put a real value in this file — it is committed to git.
#
#   Local dev  → copy to `.env` (gitignored) and fill in
#   CI/prod    → GitHub Actions secrets (Settings → Secrets and variables → Actions)
#
# If a real key is ever committed, ROTATE IT. Removing the commit is not enough.

# Firecrawl API key — used ONLY by the Python scrapers in /scrapers,
# only inside GitHub Actions. Must never reach the client bundle.
# https://firecrawl.dev → Dashboard → API Keys
FIRECRAWL_API_KEY=fc-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Sentry DSN — error reporting for the client island and the scraper runs.
# https://sentry.io → Project → Settings → Client Keys (DSN)
SENTRY_DSN=https://xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx@oXXXXXXX.ingest.sentry.io/XXXXXXX
