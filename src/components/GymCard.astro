---
/**
 * Index card. Collapsed by default; the accordion is a native <details> so it
 * works with JavaScript disabled (CLAUDE.md §8), and a named one so that
 * "only one card open at a time" is the browser's job first and ours second.
 *
 * The headline price is ALL-IN with the "/mo all-in" unit. The sticker price
 * appears only inside the breakdown (§5). A gym without a confirmed price
 * renders the "call for pricing" state — never a number, never a guess.
 */
import { getRegion } from '../lib/gyms.js';
import { perClassDerivation } from '../lib/pricing.js';
import { compactSearch, gymSearchText, normalizeSearch } from '../lib/search.js';

/** `compare` opts the card into the compare picker. Only the index wires that
 *  JS up, and a control nothing can act on is worse than no control — so region
 *  pages render the card without it rather than with a dead checkbox. */
const { gym, compare = false } = Astro.props;

const region = getRegion(gym.region);
const plan = gym.default_plan;
const badge = plan?.commitment_badge ?? null;

const CATEGORY_LABELS = {
  'gym-weights': 'Gym / weights',
  'gym-classes': 'Gym + classes',
  luxury: 'Luxury club',
  'crossfit-hiit': 'CrossFit / HIIT',
  pilates: 'Pilates',
  yoga: 'Yoga',
  boxing: 'Boxing',
  'bjj-mma': 'BJJ / MMA',
  climbing: 'Climbing',
  community: 'Community gym',
};

const money = (n) =>
  n === null || n === undefined
    ? null
    : `$${Number.isInteger(n) ? n.toLocaleString() : n.toFixed(2)}`;

const placeLabel = gym.sub_locality ?? region?.name ?? '';
const verified = gym.verified_date
  ? new Date(`${gym.verified_date}T00:00:00Z`).toLocaleDateString('en-US', {
      month: 'short',
      day: 'numeric',
      year: 'numeric',
      timeZone: 'UTC',
    })
  : null;
const sourceDomain = gym.pricing_url
  ? new URL(gym.pricing_url).hostname.replace(/^www\./, '')
  : null;
const reportHref = `mailto:reports@austingymprices.com?subject=${encodeURIComponent(
  `Price correction: ${gym.name}`,
)}`;

// ── The detail link's promise ──────────────────────────────────────────────
// "Full details →" told the reader nothing they did not already have. A good
// expansion SATISFIES — it answers the question — so the link out has to offer
// something the card did not, and say what it is. The count is the offer: three
// plans on the page is a reason to go, and the reader can see it before tapping.
//
// It must not overpromise either. A call-for-pricing row has no plans to show,
// so it promises what it actually has: what we know and where it came from.
const planCount = gym.plans.length;
const packCount = (gym.class_packs ?? []).length;
const detailLabel =
  planCount > 1
    ? `See all ${planCount} plans + fees →`
    : planCount === 1
      ? 'See full breakdown →'
      : packCount > 1
        ? `See all ${packCount} passes + fees →`
        : packCount === 1
          ? 'See full breakdown →'
          : gym.price_state === 'awaiting'
            ? 'See location & status →'
            : 'See what we know →';

// ── Classes tab: the three elements of the expanded state ──────────────────
// (a) the receipt — the winning candidate behind "from $X/class", read from
//     the same function that computed the headline so the two cannot disagree.
const classSource = gym.from_per_class_source ?? null;

// (b) the promo flag, where a deal exists. A promo never derives a number
//     (§6), so this is a FLAG beside the standing rate, never a substitute for
//     it. The headline plan's promo speaks first; failing that, a promo pack.
const promoPack = (gym.class_packs ?? []).find((k) => k.promo && k.note);
const classPromo = plan?.promo?.note ?? promoPack?.note ?? null;

// (c) one "what's included" line, ONLY where the gym published one. A pack
//     states its own expiry; a plan states whatever its note says. Silence
//     renders nothing rather than an invented description.
const classIncluded =
  classSource === null
    ? null
    : classSource.kind === 'pack'
      ? (classSource.note ??
        (classSource.expires_days
          ? `${classSource.classes} classes, valid ${classSource.expires_days} days from purchase`
          : null))
      : (classSource.note ?? null);
---

<article
  class={`card ${gym.price_state === "awaiting" || gym.price_state === "not-published" ? "card-unpriced" : ""}`}
  data-slug={gym.slug}
  data-region={gym.region}
  data-category={gym.category}
  data-tier={gym.price_tier ?? ''}
  data-allin={gym.all_in_monthly ?? ''}
  data-daypass={gym.day_pass ?? ''}
  data-nocontract={gym.is_no_contract === true ? 'true' : 'false'}
  data-classpass={gym.accepts_classpass === true ? 'true' : 'false'}
  data-pool={gym.pool === true ? 'true' : 'false'}
  data-plancount={gym.plans.length}
  data-pricestate={gym.price_state}
  data-access={gym.access_model}
  data-chain={gym.chain ?? ''}
  data-perclass={gym.from_per_class ?? ''}
  data-classtier={gym.class_tier ?? ''}
  data-name={gym.name}
  data-search={normalizeSearch(
    `${gymSearchText(gym, region?.name)} ${CATEGORY_LABELS[gym.category] ?? ''}`,
  )}
  data-search-compact={compactSearch(
    `${gymSearchText(gym, region?.name)} ${CATEGORY_LABELS[gym.category] ?? ''}`,
  )}
>
  {/* Compare checkbox. A SIBLING of <details>, never inside <summary>: a
      control inside the summary competes with the accordion for the same
      click. Hidden until the page's JS marks itself ready, so it is never a
      dead control for someone browsing without JavaScript. */}
  {/* Named group = native one-at-a-time accordion: opening a card closes any
      other, in the browser, with no JavaScript at all. The open card IS the
      map's single spotlight, so two cards open at once would be two states
      pretending to be one — which is exactly where the selection-wipe bug
      lived (§9 step 4). index.astro enforces the same rule in JS for browsers
      that predate `name`, so the invariant holds either way. */}
  <details class="card-details" name="gym-card">
    <summary class="card-top">
      <div class="card-id">
        <h2 class="card-name">
          {gym.name}
          {/* Commitment is a MEMBERSHIP concept — never shown on the Day
              passes tab, where a "2-mo minimum" above a $10 headline reads
              as a contradiction (CLAUDE.md §3, tab-aware cards). */}
          {badge && (
            <span class={`tag ${badge.tone} membership-only`}>{badge.label}</span>
          )}
        </h2>
        {/* Shown only when this card was reached by tapping its pin from
            outside the active region filter. The tap is honoured; the note
            explains why the card is here rather than letting the filter look
            broken. */}
        <p class="outside-note" hidden></p>
        {/* Injected by the index when this card stands for a whole chain.
            Server-rendered empty and hidden so a no-JS visitor sees every
            location as its own row, which is the correct ungrouped list. */}
        <p class="chain-note" hidden></p>
        <p class="card-meta">
          {placeLabel}<span class="sep">•</span>{CATEGORY_LABELS[gym.category] ?? gym.category}
        </p>
      </div>

      <div class="card-right">
        <div class="price price-membership">
          {gym.has_price ? (
            <>
              {/* "$35+" where a fee is unstated: the figure is a FLOOR, and a
                  bare "$35" would be a number we cannot stand behind. */}
              <span class="n">{money(gym.all_in_monthly)}{gym.all_in_is_floor ? '+' : ''}</span>
              <span class="u">/mo all-in</span>
            </>
          ) : gym.price_state === 'awaiting' ? (
            <span class="pending">Price coming</span>
          ) : (
            <span class="callfor">Not published</span>
          )}
        </div>
        {/* Classes tab: the comparable unit is the price of ONE CLASS. Where
            the class count is not published there is no figure — never an
            inferred one (§3). */}
        <div class="price price-class" hidden>
          {gym.from_per_class !== null ? (
            <>
              <span class="n">{money(gym.from_per_class)}</span>
              <span class="u">/class from</span>
            </>
          ) : (
            <span class="callfor">Per-class rate not published</span>
          )}
        </div>
        <div class="price price-daypass" hidden>
          {gym.day_pass !== null && gym.day_pass !== undefined ? (
            <>
              <span class="n">{money(gym.day_pass)}</span>
              <span class="u">/visit</span>
            </>
          ) : (
            <span class="callfor">Not published</span>
          )}
        </div>
        <svg
          class="chev"
          width="14"
          height="14"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.5"
          aria-hidden="true"
        >
          <path d="M6 9l6 6 6-6" />
        </svg>
      </div>
    </summary>

    <div class="detail detail-membership">
      {plan ? (
        <>
          <p class="plan-label">{plan.name}</p>
          <div class="drow">
            <span class="k">Monthly rate</span>
            <span class="v">
              {money(plan.monthly)}{gym.billing_period === 'monthly'
                ? '/mo'
                : gym.billing_period === '4-week'
                  ? ' per 4 weeks'
                  : ' per week'}
            </span>
          </div>
          {gym.billing_period !== 'monthly' && (
            <div class="drow">
              <span class="k">Billed</span>
              <span class="v">
                {gym.billing_period === '4-week' ? '13x a year' : '52x a year'}
              </span>
            </div>
          )}
          <div class="drow">
            <span class="k">Enrollment fee</span>
            <span class="v">{plan.enroll_fee === null || plan.enroll_fee === undefined ? 'Not published' : plan.enroll_fee ? money(plan.enroll_fee) : 'None'}</span>
          </div>
          <div class="drow">
            <span class="k">Annual fee</span>
            <span class="v">{plan.annual_fee === null || plan.annual_fee === undefined ? 'Not published' : plan.annual_fee ? `${money(plan.annual_fee)}/yr` : 'None'}</span>
          </div>
          <div class="drow">
            <span class="k">Commitment</span>
            <span class="v">
              {plan.commit_months === null
                ? 'Not published'
                : plan.commit_months === 0
                  ? 'Month-to-month'
                  : badge?.label}
            </span>
          </div>
          {gym.all_in_is_floor && (
            <p class="note">
              This gym does not publish its {gym.unstated_fees.join(' or ')}, so the all-in
              figure is a floor — the real cost is this or higher. We would rather show a
              number with a gap in it than a tidy one that is wrong.
            </p>
          )}
          <div class="drow total">
            <span class="k">First-year total</span>
            <span class="v">
              {money(plan.first_year_total)}{gym.all_in_is_floor ? '+' : ''} · {money(gym.all_in_monthly)}{gym.all_in_is_floor ? '+' : ''}/mo all-in
            </span>
          </div>
          {plan.note && <p class="note">{plan.note}</p>}
          {plan.promo && plan.promo.note && <p class="note promo">{plan.promo.note}</p>}
        </>
      ) : (
        <p class="note">{gym.pricing_note}</p>
      )}

      {gym.amenities.length > 0 && (
        <ul class="amen">
          {gym.amenities.map((a) => (
            <li>{a}</li>
          ))}
        </ul>
      )}

      {/* Bottom of the expansion, below the substance and above the fine
          print. A bordered pill, not a filled one: it must read as a
          destination without competing with the price, which stays the loudest
          thing on the card by an order of magnitude (1.8rem display against
          0.82rem here). No orange — that means "selected" on the map and
          nothing else — and no orange-tint, which the receipt owns. */}
      <a class="detail-cta" href={gym.url}>{detailLabel}</a>

      <div class="dfoot">
        {/* A gym whose scrape has been failing for >14 days says so in the
            warning style rather than presenting a stale number as current
            (CLAUDE.md §6). */}
        <span class={gym.stale ? 'stale' : ''}>
          {verified
            ? gym.stale
              ? `Prices last confirmed ${verified} — we have not been able to re-check since`
              : `Prices checked ${verified}${sourceDomain ? ` · from ${sourceDomain}` : ''}`
            : 'Price not yet confirmed'}
        </span>
        <span class="dfoot-links">
          <a href={reportHref}>Report a wrong price</a>
        </span>
      </div>
    </div>

    {/* Classes tab. EXACTLY three elements, and nothing else: the receipt line
        showing how the per-class figure was derived, a promo flag where a deal
        exists, and one "what's included" line only where the gym published
        one. No schedules, no amenities — those answer a different question and
        belong on the detail page. Cards scan; detail pages explain (§3). */}
    <div class="detail detail-class" hidden>
      {classSource ? (
        <>
          <p class="plan-label">How this rate is reached</p>
          <p class="receipt-line">
            <strong>{money(classSource.value)}</strong>/class ={' '}
            {perClassDerivation(classSource, money)}
          </p>
        </>
      ) : (
        <p class="note">
          This studio does not publish how many classes a membership includes, so there
          is no per-class figure to show.
        </p>
      )}

      {classPromo && <p class="note promo">{classPromo}</p>}

      {classIncluded && <p class="secondary included">{classIncluded}</p>}

      {/* Bottom of the expansion, below the substance and above the fine
          print. A bordered pill, not a filled one: it must read as a
          destination without competing with the price, which stays the loudest
          thing on the card by an order of magnitude (1.8rem display against
          0.82rem here). No orange — that means "selected" on the map and
          nothing else — and no orange-tint, which the receipt owns. */}
      <a class="detail-cta" href={gym.url}>{detailLabel}</a>

      <div class="dfoot">
        <span class={gym.stale ? 'stale' : ''}>
          {verified
            ? gym.stale
              ? `Prices last confirmed ${verified} — we have not been able to re-check since`
              : `Prices checked ${verified}${sourceDomain ? ` · from ${sourceDomain}` : ''}`
            : 'Price not yet confirmed'}
        </span>
        <span class="dfoot-links">
          <a href={reportHref}>Report a wrong price</a>
        </span>
      </div>
    </div>

    {/* Day passes tab. Leads with the pass itself; membership is demoted to a
        single secondary line. Hidden by default so the no-JS view shows the
        membership receipt, which matches the default tab. */}
    <div class="detail detail-daypass" hidden>
      {gym.day_pass !== null && gym.day_pass !== undefined ? (
        <>
          <p class="plan-label">Day pass</p>
          <div class="drow">
            <span class="k">Single visit</span>
            <span class="v">
              {money(gym.day_pass)}{gym.day_pass_qualifier ? ` ${gym.day_pass_qualifier}` : ''}
            </span>
          </div>
          {gym.day_pass_terms.length > 0 && (
            <ul class="terms">
              {gym.day_pass_terms.map((t) => (
                <li>{t}</li>
              ))}
            </ul>
          )}
          {gym.day_pass_alternative && (
            <p class="alt">{gym.day_pass_alternative}</p>
          )}
          <p class="secondary">
            {gym.has_price
              ? `Membership from ${money(gym.all_in_monthly)}/mo all-in`
              : 'Membership pricing not published'}
          </p>
        </>
      ) : (
        <p class="note">No day pass price published for this gym.</p>
      )}

      {/* Bottom of the expansion, below the substance and above the fine
          print. A bordered pill, not a filled one: it must read as a
          destination without competing with the price, which stays the loudest
          thing on the card by an order of magnitude (1.8rem display against
          0.82rem here). No orange — that means "selected" on the map and
          nothing else — and no orange-tint, which the receipt owns. */}
      <a class="detail-cta" href={gym.url}>{detailLabel}</a>

      <div class="dfoot">
        <span>
          {verified
            ? `Prices checked ${verified}${sourceDomain ? ` · from ${sourceDomain}` : ''}`
            : 'Price not yet confirmed'}
        </span>
        <span class="dfoot-links">
          <a href={reportHref}>Report a wrong price</a>
        </span>
      </div>
    </div>
  </details>

  {/* Compare control. In FLOW at the card's bottom-right, not absolutely
      positioned over it: the price owns the top-right unconditionally, and a
      chip anchored there covered it at every width. Bottom-anchored absolute
      positioning does not fix it either — a collapsed card is ~83px tall and
      the price already occupies most of that, so the two still collide. A flow
      row cannot overlap anything by construction, at any width, however the
      name or badges wrap.

      Still a SIBLING of <details>, never inside <summary>, so it does not
      compete with the accordion for the click. Hidden until the page's JS
      marks itself ready, so it is never a dead control without JavaScript. */}
  {compare && (
    <div class="cmp-row" hidden>
      <label class="cmp-pick">
        {/* An unpriced row has nothing to compare. The control is disabled
            rather than hidden so the reason is discoverable — a missing
            checkbox looks like a bug, a disabled one with a title explains
            itself. */}
        <input
          type="checkbox"
          class="cmp-box"
          data-slug={gym.slug}
          disabled={gym.price_state === 'awaiting' || gym.price_state === 'not-published'}
          title={
            gym.price_state === 'awaiting'
              ? 'No price listed yet — nothing to compare'
              : gym.price_state === 'not-published'
                ? 'This gym does not publish its prices — nothing to compare'
                : undefined
          }
          aria-label={`Compare ${gym.name}`}
        />
        {/* The word is the whole point: a bare checkbox is mystery UI.
            Labelled, it explains itself before it is touched. */}
        <span class="cmp-word" aria-hidden="true">Compare</span>
      </label>
    </div>
  )}
</article>

<style>
  .card {
    border: 1px solid var(--line);
    border-radius: var(--r);
    margin-bottom: 10px;
    background: var(--bg);
    position: relative;
    transition:
      border-color 0.12s,
      box-shadow 0.12s;
    overflow: hidden;
  }

  /* Corner, and deliberately quiet: comparing is a secondary action and must
     not compete with the price for attention. Revealed only once the island
     has booted (see index.astro), so it is never a control that does nothing. */
  .cmp-row {
    display: flex;
    justify-content: flex-end;
    padding: 0 14px 10px;
  }

  .cmp-pick {
    display: flex;
    align-items: center;
    gap: 5px;
    padding: 4px 9px 4px 7px;
    border: 1px solid var(--line);
    border-radius: var(--r-pill);
    background: var(--bg);
    cursor: pointer;
    opacity: 0.75;
    transition:
      opacity 0.12s,
      border-color 0.12s;
  }

  .cmp-word {
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--ink-soft);
    line-height: 1;
  }

  .cmp-pick:hover,
  .cmp-pick:focus-within,
  .card:hover .cmp-pick {
    opacity: 1;
  }

  .cmp-box {
    width: 15px;
    height: 15px;
    accent-color: var(--orange);
    cursor: pointer;
    margin: 0;
  }

  /* A checked chip stays legible even when the card is not hovered. */
  .cmp-pick:has(.cmp-box:checked) {
    opacity: 1;
    border-color: var(--orange);
    background: var(--orange-tint);
  }

  .cmp-pick:has(.cmp-box:checked) .cmp-word {
    color: var(--orange-dark);
  }

  /* At the cap, the remaining boxes read as unavailable rather than broken. */
  .cmp-pick:has(.cmp-box:disabled) {
    opacity: 0.3;
    cursor: not-allowed;
  }

  .cmp-pick.capped {
    opacity: 0.18;
    cursor: not-allowed;
  }

  .card:hover,
  .card.hl {
    border-color: var(--orange);
    box-shadow: var(--shadow-card-hover);
  }

  .card-details {
    width: 100%;
  }

  .card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 16px 18px;
    cursor: pointer;
    list-style: none;
  }

  .card-top::-webkit-details-marker {
    display: none;
  }

  .card-id {
    min-width: 0;
  }

  .card-name {
    font-weight: 700;
    font-size: 1rem;
    line-height: 1.3;
  }

  /* The chain expander. Quiet, and a real button: it changes what the list
     shows, so it must be reachable by keyboard and announce its state. */
  .chain-note {
    font-size: 0.72rem;
    color: var(--ink-soft);
    margin-bottom: 3px;
  }

  .chain-note button {
    font: inherit;
    color: var(--orange-dark);
    font-weight: 700;
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;
    text-decoration: underline;
  }

  .outside-note {
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--orange-dark);
    margin-bottom: 2px;
  }

  .card-meta {
    font-size: 0.8rem;
    color: var(--ink-soft);
    margin-top: 3px;
  }

  .card-meta .sep {
    margin: 0 6px;
    color: var(--line);
  }

  .tag {
    display: inline-block;
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.03em;
    border-radius: 5px;
    padding: 2px 7px;
    margin-left: 8px;
    vertical-align: 1px;
    white-space: nowrap;
  }

  .tag.green {
    background: var(--green-tint);
    color: var(--green);
  }

  .tag.neutral {
    background: var(--neutral-badge-bg);
    color: var(--ink-soft);
  }

  .card-right {
    display: flex;
    align-items: center;
    gap: 12px;
    flex: none;
  }

  .price {
    text-align: right;
  }

  .price .n {
    display: block;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.8rem;
    line-height: 1;
  }

  .price .u {
    font-size: 0.72rem;
    color: var(--ink-soft);
    font-weight: 500;
  }

  /* Unpriced rows read as a DIFFERENT KIND of row, not as a broken priced one.
     Muted surface and softened text, and crucially no price block at all — no
     "$—", which reads as an error rather than as an absence. */
  .card-unpriced {
    background: var(--surface-sunk);
    border-color: var(--line);
  }

  .card-unpriced .card-name {
    color: var(--ink-soft);
  }

  .pending {
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.03em;
    color: var(--ink-faint);
    display: block;
    max-width: 7.5em;
    line-height: 1.25;
  }

  .callfor {
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--ink-soft);
    display: block;
    max-width: 7.5em;
    line-height: 1.25;
  }

  .chev {
    flex: none;
    transition: transform 0.18s;
    color: var(--ink-soft);
  }

  .card-details[open] .chev {
    transform: rotate(180deg);
  }

  .detail {
    border-top: 1px solid var(--line);
    padding: 16px 18px;
    background: var(--surface-sunk);
  }

  .plan-label {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-soft);
    margin-bottom: 8px;
  }

  .drow {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    font-size: 0.86rem;
    padding: 5px 0;
  }

  .drow .k {
    color: var(--ink-soft);
  }

  .drow .v {
    font-weight: 600;
    text-align: right;
  }

  .drow.total {
