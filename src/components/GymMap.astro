---
/**
 * Leaflet map island (CLAUDE.md §9 step 4).
 *
 * The map is progressive enhancement over the list: this component renders an
 * empty container and a JSON data block, and the Leaflet bundle is imported
 * dynamically only when the map scrolls into view or the mobile toggle is
 * pressed. The list is fully usable before any map byte arrives.
 */
import { getAllGyms } from '../lib/gyms.js';

// Only what the map needs. Keeping the payload tight matters — it ships inline.
const pins = getAllGyms()
  .filter((g) => g.lat !== null && g.lng !== null)
  .map((g) => ({
    slug: g.slug,
    name: g.name,
    lat: g.lat,
    lng: g.lng,
    allIn: g.all_in_monthly,
    dayPass: g.day_pass,
    tier: g.price_tier,
  }));
---

<div class="mapwrap" id="mapwrap" data-pins={JSON.stringify(pins)}>
  <div id="map" class="map" role="application" aria-label="Map of Austin gyms"></div>
  {/* Neutral phrasing: a visitor should not read a completeness scoreboard.
      Once most gyms are placed the note stops earning its space and is
      dropped entirely. */}
  {pins.length < 35 && (
    <p class="map-note">Showing gyms with a confirmed address</p>
  )}
</div>

<style>
  .mapwrap {
    position: sticky;
    top: 0;
    height: 100vh;
    min-height: 620px;
    background: var(--map-ground);
    overflow: hidden;
  }

  .map {
    width: 100%;
    height: 100%;
  }

  .map-note {
    position: absolute;
    bottom: 16px;
    left: 16px;
    z-index: 500;
    background: #fff;
    border: 1px solid var(--line);
    border-radius: 8px;
    font-size: 0.72rem;
    color: var(--ink-soft);
    padding: 7px 12px;
    box-shadow: 0 1px 4px rgba(0, 0, 0, 0.05);
  }

  /* Price bubbles. Tier tints per §9: 1 green, 2 neutral, 3 ink. */
  :global(.pin) {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 26px;
    padding: 0 9px;
    border-radius: 13px;
    font: 700 12px var(--font-body);
    white-space: nowrap;
    border: 1px solid var(--pin-stroke);
    background: #fff;
    color: var(--ink);
    box-shadow: 0 2px 5px rgba(33, 29, 25, 0.14);
    cursor: pointer;
    transition:
      opacity 0.15s,
      transform 0.12s;
  }

  :global(.pin.tier-1) {
    background: var(--green-tint);
    border-color: #BFE0CD;
    color: var(--green);
  }

  :global(.pin.tier-3) {
    background: var(--ink);
    border-color: var(--ink);
    color: #fff;
  }

  /* Unpriced: visible but secondary. */
  :global(.pin.callfor) {
    background: transparent;
    border: 1.5px dashed var(--dash);
    color: var(--ink-soft);
    box-shadow: none;
    font-weight: 600;
  }

  /* Filtered out. */
  :global(.pin.dim) {
    opacity: 0.18;
    pointer-events: none;
  }

  /* Day-pass tab, gym has no published pass. */
  :global(.pin.nopass) {
    opacity: 0.25;
    pointer-events: none;
  }

  /* Cluster label is the PRICE RANGE of its members, never a count. */
  :global(.pin.cluster) {
    background: #fff;
    border-color: var(--ink-soft);
    color: var(--ink);
    font-weight: 700;
  }

  /* MUST come last. Selected must be unmistakable against every other pin
   * state, and these are all single-specificity class pairs, so source order
   * decides. Defined before .pin.cluster, a selected cluster kept the white
   * cluster fill and showed only the ring — a faint halo instead of the full
   * treatment. A selected cluster now gets exactly what a selected lone pin
   * gets. Orange is the selected colour and nothing else uses it as a fill;
   * ink means expensive (tier 3), never selected.
   * scripts/check-map.mjs asserts this rule stays last. */
  :global(.pin.active) {
    background: var(--orange);
    border-color: var(--orange-dark);
    color: #fff;
    box-shadow:
      0 0 0 4px rgba(191, 87, 0, 0.3),
      0 3px 10px rgba(33, 29, 25, 0.25);
    transform: scale(1.12);
    z-index: 1000;
  }

  :global(.leaflet-container) {
    background: var(--map-ground);
    font: inherit;
  }

  :global(.leaflet-control-attribution) {
    font-size: 10px;
    background: rgba(255, 255, 255, 0.85);
  }

  @media (max-width: 920px) {
    .mapwrap {
      position: fixed;
      inset: 0;
      height: 100dvh;
      z-index: 900;
      display: none;
    }

    .mapwrap.open {
      display: block;
    }
  }
</style>
