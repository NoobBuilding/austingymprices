---
/**
 * Leaflet map island (CLAUDE.md §9 step 4).
 *
 * The map is progressive enhancement over the list: this component renders an
 * empty container and a JSON data block, and the Leaflet bundle is imported
 * dynamically only when the map scrolls into view or the mobile toggle is
 * pressed. The list is fully usable before any map byte arrives.
 */
import { getAllGyms } from '../lib/gyms.js';

// Only what the map needs. Keeping the payload tight matters — it ships inline.
const pins = getAllGyms()
  .filter((g) => g.lat !== null && g.lng !== null)
  .map((g) => ({
    slug: g.slug,
    name: g.name,
    lat: g.lat,
    lng: g.lng,
    allIn: g.all_in_monthly,
    dayPass: g.day_pass,
    perClass: g.from_per_class,
    tier: g.price_tier,
    classTier: g.class_tier,
  }));
---

<div class="mapwrap" id="mapwrap" data-pins={JSON.stringify(pins)}>
  <div id="map" class="map" role="application" aria-label="Map of Austin gyms"></div>
  {/* Neutral phrasing: a visitor should not read a completeness scoreboard.
      Once most gyms are placed the note stops earning its space and is
      dropped entirely. */}
  {pins.length < 35 && (
    <p class="map-note">Showing gyms with a confirmed address</p>
  )}
</div>

<style>
  .mapwrap {
    position: sticky;
    top: 0;
    height: 100vh;
    min-height: 620px;
    background: var(--map-ground);
    overflow: hidden;
  }

  .map {
    width: 100%;
    height: 100%;
  }

  .map-note {
    position: absolute;
    bottom: 16px;
    left: 16px;
    z-index: 500;
    background: #fff;
    border: 1px solid var(--line);
    border-radius: 8px;
    font-size: 0.72rem;
    color: var(--ink-soft);
    padding: 7px 12px;
    box-shadow: 0 1px 4px rgba(0, 0, 0, 0.05);
  }

  /* Price bubbles. Tier tints per §9: 1 green, 2 neutral, 3 ink. */
  :global(.pin) {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 26px;
    padding: 0 9px;
    border-radius: 13px;
    font: 700 12px var(--font-body);
    white-space: nowrap;
    border: 1px solid var(--pin-stroke);
    background: #fff;
    color: var(--ink);
    box-shadow: 0 2px 5px rgba(33, 29, 25, 0.14);
    cursor: pointer;
    transition:
      opacity 0.15s,
      transform 0.12s;
  }

  :global(.pin.tier-1) {
    background: var(--green-tint);
    border-color: #BFE0CD;
    color: var(--green);
  }

  :global(.pin.tier-3) {
    background: var(--ink);
    border-color: var(--ink);
    color: #fff;
  }

  /* Unpriced: visible but secondary. */
  :global(.pin.callfor) {
    background: transparent;
    border: 1.5px dashed var(--dash);
    color: var(--ink-soft);
    box-shadow: none;
    font-weight: 600;
  }

  /* Filtered out. */
  :global(.pin.dim) {
    opacity: 0.18;
    pointer-events: none;
  }

  /* Day-pass tab, gym has no published pass. */
  :global(.pin.nopass) {
    opacity: 0.25;
    pointer-events: none;
  }

  /* A merged bubble stands on gyms that are effectively at the same address.
     It reads "$38 +1": the cheapest price it is covering, and how many more are
     underneath. Never a range, never a bare count. Click to fan it open. */
  :global(.pin.merged) {
    background: #fff;
    border-color: var(--ink-soft);
    color: var(--ink);
    font-weight: 700;
    box-shadow:
      2px 2px 0 -1px #fff,
      2px 2px 0 0 var(--ink-soft),
      0 2px 5px rgba(33, 29, 25, 0.14);
  }

  /* Fanned open: the members of a merged bubble, pushed out around the point
     they share. Ringed so the group they came from stays legible. */
  :global(.pin.fanned) {
    box-shadow:
      0 0 0 2px rgba(107, 99, 91, 0.35),
      0 2px 5px rgba(33, 29, 25, 0.18);
  }

  /* ── Dots mode ────────────────────────────────────────────────────────
   * Location-first browsing: tier tint survives, the number does not. A price
   * on every pin invites writing a gym off before reading a word about it.
   * These rules only resize and round the same bubble, so every state rule
   * above (tier tint, dim, nopass, merged) still applies unchanged — and
   * .pin.active below still wins the colours it sets. */
  :global(.pin.dot) {
    width: 14px;
    height: 14px;
    padding: 0;
    border-radius: 50%;
    font-size: 0;
    box-shadow: 0 1px 3px rgba(33, 29, 25, 0.28);
  }

  /* A merged dot is bigger, because "more than one gym here" is the one thing
   * a dot still has to say once the price is gone. */
  :global(.pin.dot.merged) {
    width: 18px;
    height: 18px;
    border-width: 2px;
  }

  :global(.pin.dot.callfor) {
    border-width: 1.5px;
  }

  /* The display toggle. Quiet by design — a preference, not a filter. */
  :global(.map-display) {
    display: flex;
    background: #fff;
    border: 1px solid var(--line);
    border-radius: var(--r-pill);
    overflow: hidden;
    box-shadow: 0 1px 4px rgba(33, 29, 25, 0.12);
  }

  :global(.map-display-btn) {
    border: 0;
    background: transparent;
    color: var(--ink-soft);
    font: 600 11px var(--font-body);
    padding: 6px 11px;
    cursor: pointer;
    line-height: 1.4;
  }

  :global(.map-display-btn:hover) {
    color: var(--ink);
  }

  /* Neutral on purpose. Orange means "selected" and ink means "expensive" on
   * this map, and both meanings are exclusive (CLAUDE.md §9 step 4) — chrome
   * does not get to borrow either one. */
  :global(.map-display-btn.on) {
    background: var(--surface-sunk);
    color: var(--ink);
    font-weight: 700;
    box-shadow: inset 0 0 0 1px var(--line);
  }

  /* Legend. Deliberately small and quiet — it explains the map, it is not part
     of it. Sits above the attribution in the bottom-right stack. */
  :global(.map-legend) {
    background: rgba(255, 255, 255, 0.94);
    border: 1px solid var(--line);
    border-radius: 8px;
    padding: 7px 9px;
    display: grid;
    gap: 4px;
    box-shadow: 0 1px 4px rgba(33, 29, 25, 0.1);
  }

  :global(.legend-row) {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  /* The swatch reuses the real pin classes, so a legend entry can never drift
     from the thing it claims to describe — restyle a pin and the key follows.
     Overrides only geometry, never colour.
     Three classes on purpose: .pin.active is (0,2,0) and MUST stay declared
     last, so an equal-specificity override here would lose and the "Selected"
     swatch would arrive scaled and glowing. Winning on specificity instead
     leaves that ordering rule untouched. */
  :global(.map-legend .pin.legend-chip) {
    width: 15px;
    height: 11px;
    min-width: 15px;
    padding: 0;
    border-radius: 6px;
    font-size: 0;
    cursor: default;
    transform: none;
    box-shadow: none;
    z-index: auto;
  }

  :global(.legend-label) {
    font: 600 10px var(--font-body);
    color: var(--ink-soft);
    white-space: nowrap;
    line-height: 1.3;
  }

  @media (max-width: 420px) {
    /* A phone-width map has no room for both the key and the pins it explains. */
    :global(.map-legend) {
      display: none;
    }
  }

  /* MUST come last. Selected must be unmistakable against every other pin
   * state, and these are all single-specificity class pairs, so source order
   * decides. Defined before .pin.merged, a selected merged bubble kept the
   * white merged fill and showed only the ring — a faint halo instead of the
   * full treatment. A selected merged bubble now gets what a selected lone pin
   * gets. Orange is the selected colour and nothing else uses it as a fill;
   * ink means expensive (tier 3), never selected.
   * scripts/check-map.mjs asserts this rule stays last. */
  :global(.pin.active) {
    background: var(--orange);
    border-color: var(--orange-dark);
    color: #fff;
    box-shadow:
      0 0 0 4px rgba(191, 87, 0, 0.3),
      0 3px 10px rgba(33, 29, 25, 0.25);
    transform: scale(1.12);
    z-index: 1000;
  }

  :global(.leaflet-container) {
    background: var(--map-ground);
    font: inherit;
  }

  :global(.leaflet-control-attribution) {
    font-size: 10px;
    background: rgba(255, 255, 255, 0.85);
  }

  @media (max-width: 920px) {
    .mapwrap {
      position: fixed;
      inset: 0;
      height: 100dvh;
      z-index: 900;
      display: none;
    }

    .mapwrap.open {
      display: block;
    }
  }
</style>
