---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  /** Path-only canonical, e.g. "/gyms/big-tex-gym". Defaults to the current URL. */
  canonicalPath?: string;
  /** OG card basename in /og, without extension. Defaults to the site card. */
  ogImage?: string;
  /** Keep the page out of the index. Used by /compare, whose useful URLs are
   *  query strings with a combinatorial number of values and no search value. */
  noindex?: boolean;
}

const { title, description, canonicalPath, ogImage, noindex } = Astro.props;
const canonical = new URL(canonicalPath ?? Astro.url.pathname, Astro.site);
const ogUrl = new URL(`/og/${ogImage ?? 'default'}.png`, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical.href} />
    {noindex && <meta name="robots" content="noindex, follow" />}

    {/* SVG first for browsers that take it (sharp at any size, one file);
        favicon.ico is the fallback and is deliberately NOT declared with a
        `sizes` attribute, so old browsers fall back to /favicon.ico anyway.
        Same artwork in all three — the "A" is the real Barlow Condensed 700
        glyph as a path, since a favicon cannot fetch a webfont. */}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#BF5700" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:site_name" content="Austin Gym Prices" />
    <meta property="og:image" content={ogUrl.href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogUrl.href} />

    <!-- Self-hosted; no preconnect to a font CDN because there is no font CDN. -->
    <link
      rel="preload"
      href="/fonts/inter-variable-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/barlow-condensed-700-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
  </head>

  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <header class="site-header">
      <a class="logo" href="/">
        <span class="logo-accent">Austin</span><span class="logo-ink">GymPrices</span>
      </a>
      <nav class="hdr-links" aria-label="Main">
        <a href="/">Browse gyms</a>
        <a href="/for-gym-owners">For gym owners</a>
        <a href="/faq">FAQ</a>
      </nav>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <p class="foot-brand">
        <span class="logo-accent">Austin</span><span class="logo-ink">GymPrices</span>
      </p>
      <nav class="foot-links" aria-label="Footer">
        <a href="/faq">FAQ</a>
        <a href="/for-gym-owners">For gym owners</a>
        <a href="mailto:reports@austingymprices.com?subject=Price%20correction">Report a wrong price</a>
      </nav>
      <p class="foot-note">
        Not affiliated with any gym listed. Prices come from each gym's own website;
        every listing shows the date it was last checked.
      </p>
    </footer>
  </body>
</html>

<style>
  .site-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 16px 32px;
    border-bottom: 1px solid var(--line);
  }

  /* CLAUDE.md §5: "AUSTIN" in orange, "GYMPRICES" in ink. This deliberately
   * differs from the mockups, which colour "GYM" — the word carrying the
   * Austin identity gets the Austin colour. */
  .logo {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.45rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    text-decoration: none;
  }

  .logo-accent {
    color: var(--orange);
  }

  .logo-ink {
    color: var(--ink);
  }

  .hdr-links {
    display: flex;
    gap: 26px;
    align-items: center;
    font-size: 0.88rem;
    font-weight: 500;
    color: var(--ink-soft);
  }

  .hdr-links a {
    color: inherit;
    text-decoration: none;
  }

  .hdr-links a:hover {
    color: var(--orange);
  }

  .site-footer {
    border-top: 1px solid var(--line);
    padding: 30px 32px 48px;
    margin-top: 40px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    align-items: flex-start;
  }

  .foot-brand {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.05rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .foot-links {
    display: flex;
    gap: 20px;
    flex-wrap: wrap;
    font-size: 0.85rem;
    font-weight: 500;
  }

  .foot-links a {
    color: var(--ink-soft);
    text-decoration: none;
  }

  .foot-links a:hover {
    color: var(--orange);
  }

  .foot-note {
    font-size: 0.78rem;
    color: var(--ink-faint);
    max-width: 62ch;
    line-height: 1.5;
  }

  @media (max-width: 560px) {
    .site-footer {
      padding: 26px 18px 40px;
    }

    .site-header {
      padding: 14px 18px;
      flex-wrap: wrap;
    }

    .hdr-links {
      gap: 18px;
      font-size: 0.82rem;
    }
  }
</style>
