---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  /** Path-only canonical, e.g. "/gyms/big-tex-gym". Defaults to the current URL. */
  canonicalPath?: string;
}

const { title, description, canonicalPath } = Astro.props;
const canonical = new URL(canonicalPath ?? Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical.href} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:site_name" content="Austin Gym Prices" />
    <meta name="twitter:card" content="summary_large_image" />

    <!-- Self-hosted; no preconnect to a font CDN because there is no font CDN. -->
    <link
      rel="preload"
      href="/fonts/inter-variable-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/barlow-condensed-700-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
  </head>

  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <header class="site-header">
      <a class="logo" href="/">
        <span class="logo-accent">Austin</span><span class="logo-ink">GymPrices</span>
      </a>
      <nav class="hdr-links" aria-label="Main">
        <a href="/">Browse gyms</a>
        <a href="/for-gym-owners">For gym owners</a>
        <a href="/faq">FAQ</a>
      </nav>
    </header>

    <main id="main">
      <slot />
    </main>
  </body>
</html>

<style>
  .site-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 16px 32px;
    border-bottom: 1px solid var(--line);
  }

  /* CLAUDE.md §5: "AUSTIN" in orange, "GYMPRICES" in ink. This deliberately
   * differs from the mockups, which colour "GYM" — the word carrying the
   * Austin identity gets the Austin colour. */
  .logo {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.45rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    text-decoration: none;
  }

  .logo-accent {
    color: var(--orange);
  }

  .logo-ink {
    color: var(--ink);
  }

  .hdr-links {
    display: flex;
    gap: 26px;
    align-items: center;
    font-size: 0.88rem;
    font-weight: 500;
    color: var(--ink-soft);
  }

  .hdr-links a {
    color: inherit;
    text-decoration: none;
  }

  .hdr-links a:hover {
    color: var(--orange);
  }

  @media (max-width: 560px) {
    .site-header {
      padding: 14px 18px;
      flex-wrap: wrap;
    }

    .hdr-links {
      gap: 18px;
      font-size: 0.82rem;
    }
  }
</style>
